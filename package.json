{
  "name": "r16n",
  "version": "2.0.0",
  "description": "Redux internationalization. This library provides Redux reducer to translate strings, and React components and hooks to localize dates, and numbers.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "node scripts/smoke-test.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run lint:package && npm run test:smoke",
    "prepublishOnly": "npm run check",
    "lint:package": "publint && attw --pack ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/razodeh/r16n.git"
  },
  "keywords": [
    "i18n",
    "internationalization",
    "intl",
    "localization",
    "globalization",
    "translation",
    "locale",
    "l10n",
    "format",
    "react",
    "reactjs",
    "redux",
    "react-redux",
    "hooks"
  ],
  "author": "Radwan Abu-Odeh <radwanizzat@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/razodeh/r16n/issues"
  },
  "homepage": "https://github.com/razodeh/r16n#readme",
  "dependencies": {
    "moment": "^2.31.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-redux": "^9.0.0",
    "redux": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "redux": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@reduxjs/toolkit": "^2.13.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "redux": "^5.0.1",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
